# 数据库配置（含密码）- 绝对不能提交
db_config.json

# 支付通道配置（含商户密钥）- 绝对不能提交
pay_config.php

# 部署配置（含宝塔 API 密钥）- 绝对不能提交
.env.deploy

# 上传的文件（.htaccess 需随仓库发布，用于禁用 PHP 执行）
uploads/*
!uploads/.htaccess

# 备份目录
backup_*/

# 系统文件
# 注意：.htaccess 不能忽略，否则 GitHub Release 包不含它，新部署将无任何敏感文件防护
.user.ini
.user.ini.bak

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Reasonix
.reasonix/

# 本地探针 / 测试脚本（不发布）
_up_probe.ps1
_emoji_test.txt

# 发布产物
*.zip

# 工作区 Agent Notes（仅本地，不发布到公开仓库）
.agents/

# QQ 网关客户端安装目录标记（由 tools/qqgw/install.sh 生成，含本机路径）
.qqgw_dir
