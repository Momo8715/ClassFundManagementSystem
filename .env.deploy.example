# ============================================
# 一键部署配置模板
# 使用方法：复制本文件为 .env.deploy 后填写
#   cp .env.deploy.example .env.deploy
# ⚠️ .env.deploy 已在 .gitignore 中，绝不会被提交
# ============================================

# —— 宝塔面板配置 ——
# 面板地址（含端口，http 或 https）
BT_PANEL_URL=https://your-server.com:8888
# 面板 API 密钥：宝塔面板 → 面板设置 → API 接口 → 生成密钥
BT_API_KEY=your_api_key_here
# 站点根目录绝对路径（宝塔 → 网站 中查看）
BT_SITE_PATH=/www/wwwroot/classfund.陌沫.cn

# —— GitHub 配置 ——
# 仓库地址（用户名/仓库名）
GITHUB_REPO=Momo8715/ClassFundManagementSystem
# GitHub Token（可选，公开仓库可不填；私有仓库或调用频繁时填写）
# 生成：GitHub → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=
